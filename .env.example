# ==============================================================================
# DAINIK JAGAT SAMEEKSHA (दैनिक जगत समीक्षा) — ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: Never commit production credentials, secret keys, or passwords.
# Only public keys (anon key, Turnstile site key) may be exposed to the client.

# ------------------------------------------------------------------------------
# 1. Client-Side Variables (Exposed to the browser via Vite / VITE_ prefix)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Publication Defaults
VITE_SITE_NAME=दैनिक जगत समीक्षा
VITE_DEFAULT_LOCALE=hi
VITE_TIMEZONE=Asia/Kolkata

# Local Development Demo Mode (MUST BE false IN PRODUCTION)
# When false, real Supabase authentication is required for /admin.
VITE_DEMO_MODE=false

# Cloudflare Turnstile CAPTCHA (Public Site Key)
# Optional in dev; if omitted, Turnstile validation gracefully logs a warning.
VITE_TURNSTILE_SITE_KEY=

# ------------------------------------------------------------------------------
# 2. Server-Side Variables (NEVER expose to browser / NO VITE_ prefix)
# Configure these in your Vercel Project Settings > Environment Variables
# ------------------------------------------------------------------------------
# Cloudflare Turnstile Secret Key (for server-side token verification)
TURNSTILE_SECRET_KEY=

# Secret Salt for hashing client IPs (SHA-256) before storing in news_tips
# Generate using: openssl rand -hex 32
IP_HASH_SALT=placeholder-secret-salt-generate-with-openssl-rand-hex-32

# Upstash Redis (Optional for distributed rate-limiting on serverless instances)
# If omitted, safe in-memory rate limiting fallback is used
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase Service Role Key (Used ONLY in privileged server-side operations)
# WARNING: NEVER import into client code or prefix with VITE_ / NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
